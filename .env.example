# ==============================================================================
# SourceBook V1 Configuration
# ==============================================================================

# Server Port & Database
PORT=5000
DB_PATH=database/sourcebook.db

# Search & Scraping Providers
SEARXNG_URL=http://localhost:8080
SEARQON_URL=http://localhost:4001
SEARQON_SCRAPE_URL=http://localhost:4001/scrape/batch

# LLM Configuration (Supported: "ollama", "openai", "groq", "9router", "vllm")
LLM_PROVIDER=ollama
LLM_URL=http://localhost:11434
LLM_MODEL=gemma2
LLM_API_KEY=

# Local Embedding Microservice (all-MiniLM-L6-v2 ONNX) or Ollama/OpenAI
EMBEDDING_SERVICE_URL=http://localhost:6002
EMBEDDING_URL=http://localhost:6002
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Microservices
YOUTUBE_SERVICE_URL=http://127.0.0.1:6001
SEARCH_SERVICE_URL=http://localhost:8010
SEARCH_SERVICE_TIMEOUT_SECONDS=60

# Ingestion Constraints
AGENTIC_INGESTION_MAX_RESULTS=5
AGENTIC_INGESTION_TEXT_THRESHOLD=50
